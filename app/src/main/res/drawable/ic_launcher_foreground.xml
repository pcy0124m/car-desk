<?xml version="1.0" encoding="utf-8"?>
<!-- 启动图标前景：白色方向盘（圆环 + 三辐条） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- 方向盘外环（evenOdd 挖空成圆环） -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,14 a40,40 0 1 0,0.001 0 z M54,30 a24,24 0 1 1,-0.001 0 z" />

    <!-- 上辐条 -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="0">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M51,54 L57,54 L57,68 L51,68 Z" />
    </group>

    <!-- 右下辐条（旋转 120°） -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="120">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M51,54 L57,54 L57,68 L51,68 Z" />
    </group>

    <!-- 左下辐条（旋转 240°） -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="240">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M51,54 L57,54 L57,68 L51,68 Z" />
    </group>
</vector>

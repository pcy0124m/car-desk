<?xml version="1.0" encoding="utf-8"?>
<!-- 车机桌面主布局：左侧快捷栏 + 中间卡片列 + 右侧高德地图区 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dock_start">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- ══════════ 左侧快捷栏 ══════════ -->
        <LinearLayout
            android:id="@+id/sideDock"
            android:layout_width="84dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_side_dock"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/dockSlots"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical" />

            <ImageView
                android:id="@+id/btnDrawer"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_icon_circle_blue"
                android:contentDescription="@string/drawer_title"
                android:padding="14dp"
                android:src="@drawable/ic_grid" />
        </LinearLayout>

        <!-- ══════════ 中间卡片列 ══════════ -->
        <LinearLayout
            android:id="@+id/cardColumn"
            android:layout_width="250dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_column"
            android:orientation="vertical"
            android:padding="10dp">

            <com.loomy.cardesk.card.NavCardView
                android:id="@+id/navCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <com.loomy.cardesk.card.MusicCardView
                android:id="@+id/musicCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <com.loomy.cardesk.card.VehicleCardView
                android:id="@+id/vehicleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/btnAddCard"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_slot_dashed"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:alpha="0.85"
                    android:src="@drawable/ic_add" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="添加卡片"
                    android:textColor="@color/text_on_dark"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════ 右侧地图区 ══════════ -->
        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#E8F0F8">

            <!-- 高德 MapView 将在代码中动态创建并 addView 到这里 -->

            <!-- 顶部悬浮条：左侧时间/信号，右侧状态+退出 -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@drawable/bg_card"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/topTimeLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="15:02"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/topWifi"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_wifi" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/topMic"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_icon_circle_blue"
                    android:padding="6dp"
                    android:src="@drawable/ic_mic" />

                <ImageView
                    android:id="@+id/topPhone"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_icon_circle_green"
                    android:padding="6dp"
                    android:src="@drawable/ic_phone" />

                <TextView
                    android:id="@+id/topTimeRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="15:02"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/topBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_icon_circle_green"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="100%"
                    android:textColor="@color/text_on_dark"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/btnHome"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_icon_circle_orange"
                    android:contentDescription="主页"
                    android:padding="6dp"
                    android:src="@drawable/ic_home" />

                <ImageView
                    android:id="@+id/btnExit"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_icon_circle_blue"
                    android:contentDescription="退出"
                    android:padding="7dp"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <!-- 地图搜索悬浮面板 -->
            <LinearLayout
                android:id="@+id/searchPanel"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="18dp"
                android:layout_marginTop="84dp"
                android:background="@drawable/bg_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_slot_dashed"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/search_dest_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSetHome"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_icon_circle_orange"
                        android:gravity="center"
                        android:text="@string/set_home"
                        android:textColor="@color/text_on_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnSetCompany"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_icon_circle_blue"
                        android:gravity="center"
                        android:text="@string/set_company"
                        android:textColor="@color/text_on_dark"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 地图右下角：缩放 + 天气 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/weatherCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_sun" />

                    <TextView
                        android:id="@+id/weatherTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="28°C"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/btnZoomIn"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_icon_circle_blue"
                        android:contentDescription="放大"
                        android:padding="8dp"
                        android:src="@drawable/ic_add" />

                    <ImageView
                        android:id="@+id/btnZoomOut"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_icon_circle_orange"
                        android:contentDescription="缩小"
                        android:padding="9dp"
                        android:src="@drawable/ic_close" />
                </LinearLayout>
            </LinearLayout>

            <!-- 高德 Key 未配置时的提示 -->
            <LinearLayout
                android:id="@+id/keyMissingHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_card"
                android:elevation="8dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/map_key_missing"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
